{% comment %}
  "Visit Us" band: lab rooms, address, directions, and Stinson-Remick photo.
  Used on the homepage, and on any page whose front matter has  visit_us: true
{% endcomment %}
<style>
  /* ── Visit Us ── */
  .hp-visit {
    background: #0c2340;
    padding: 3.25rem 3rem;
  }
  .hp-visit-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  @media (max-width: 900px) {
    .hp-visit-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
  @media (max-width: 768px) {
    .hp-visit {
      padding: 2.5rem 1.25rem;
    }
  }
  .hp-visit-rooms {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .hp-visit-rooms li {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.85rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.04);
  }
  .hp-visit-rooms i {
    font-size: 24px;
    color: var(--amp-gold);
    flex-shrink: 0;
  }
  .hp-visit-rooms strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 17px;
    font-weight: 700;
    color: #fff;
  }
  .hp-visit-rooms span {
    display: block;
    font-size: 16px;
    color: rgba(255, 255, 255, 0.78);
  }
  .hp-visit-address {
    display: flex;
    gap: 0.9rem;
    font-size: 17px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.78);
    margin: 0 0 1.5rem;
    padding: 0 1rem;
  }
  .hp-visit-address span {
    color: rgba(255, 255, 255, 0.78);
  }
  .hp-visit-address i {
    font-size: 24px;
    color: var(--amp-gold);
    flex-shrink: 0;
  }
  .hp-visit-link {
    display: inline-block;
    font-size: 15px;
    font-weight: 600;
    padding: 12px 24px;
    border-radius: 6px;
    background: #c99700;
    color: #0c2340;
    text-decoration: none;
  }
  .hp-visit-link:hover {
    background: #e0ac0a;
    color: #0c2340;
    text-decoration: none;
  }
  .hp-visit-photo {
    margin: 0;
  }
  .hp-visit-photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 12px;
  }
  .hp-visit-photo figcaption {
    margin-top: 0.4rem;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.55);
    text-align: right;
  }

  /* Shared bits the section needs on any page (mirrors the homepage section styles) */
  .hp-visit .hp-inner {
    max-width: 1280px;
    margin-left: auto;
    margin-right: auto;
  }
  .hp-visit .hp-section-label {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--amp-gold);
    margin-bottom: 0.7rem;
  }
  .hp-visit .hp-section-title {
    font-family: var(--font-heading);
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.01em;
    margin-bottom: 1.75rem;
  }
</style>

<section class="hp-visit">
  <div class="hp-inner hp-visit-layout">
    <div class="hp-visit-text">
      <div class="hp-section-label">Visit Us</div>
      <div class="hp-section-title" style="color:#fff;">AMPERE Lab</div>
      <ul class="hp-visit-rooms">
        <li>
          <i class="ti ti-cpu" aria-hidden="true"></i>
          <div><strong>Low Power Laboratory</strong><span>Room 317, Stinson-Remick Hall</span></div>
        </li>
        <li>
          <i class="ti ti-bolt" aria-hidden="true"></i>
          <div><strong>High Power Laboratory</strong><span>Room 322, Stinson-Remick Hall</span></div>
        </li>
      </ul>
      <p class="hp-visit-address">
        <i class="ti ti-map-pin" aria-hidden="true"></i>
        <span>
          Stinson-Remick Hall of Engineering<br>
          University of Notre Dame<br>
          South Bend, IN 46637
        </span>
      </p>
      <a
        class="hp-visit-link"
        href="https://maps.google.com/?q=Stinson-Remick+Hall+of+Engineering,+University+of+Notre+Dame,+South+Bend,+IN+46637"
        target="_blank"
        rel="noopener"
      >
        Get directions →
      </a>
    </div>
    <figure class="hp-visit-photo">
      <img
        src="{{ '/assets/img/stinson-remick-fall-1400.jpg' | relative_url }}"
        alt="Stinson-Remick Hall of Engineering in the fall, University of Notre Dame"
        width="1400"
        height="998"
        loading="lazy"
      >
      <figcaption>Photo: Matt Cashore / University of Notre Dame</figcaption>
    </figure>
  </div>
</section>
