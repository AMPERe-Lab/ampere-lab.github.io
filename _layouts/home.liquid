---
layout: default
---
<style>
  /* ── Break out of Bootstrap .container and al-folio max_width ── */
  .container:has(.hp-wrap) {
    margin-top: 0 !important;
    max-width: 100% !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
  }

  /* Inner width guard: content stays readable on ultra-wide screens */
  .hp-inner {
    max-width: 1280px;
    margin-left: auto;
    margin-right: auto;
  }

  .hp-wrap {
    font-family: var(--font-body);
  }

  /* ── Hero: campus banner photo, then lab name and intro (Matt Lee style) ── */
  .hp-hero {
    padding: 2rem 3rem 3.25rem;
    border-bottom: 1px solid var(--color-border-tertiary);
  }
  .hp-banner {
    margin: 0 0 1.75rem;
  }
  .hp-banner img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2.4 / 1;
    object-fit: cover;
    object-position: 50% 0%;
    border-radius: 6px;
  }
  .hp-banner figcaption {
    margin-top: 0.4rem;
    font-size: 12px;
    color: var(--color-text-tertiary);
    text-align: right;
  }
  .hp-title {
    font-family: var(--font-heading);
    font-size: 44px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--color-text-primary);
    margin: 0 0 0.6rem;
  }
  .hp-affil {
    font-size: 18px;
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin: 0 0 1.1rem;
  }
  .hp-tagline {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.005em;
    color: var(--amp-gold);
    margin: 0 0 1.1rem;
  }
  html[data-theme='dark'] .hp-tagline {
    color: var(--amp-gold);
  }
  .hp-hero-desc {
    font-size: 18px;
    line-height: 1.65;
    color: var(--color-text-secondary);
    max-width: 860px;
    margin: 0 0 1.75rem;
  }
  .hp-hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hp-hero-btn {
    font-size: 15px;
    font-weight: 600;
    padding: 12px 24px;
    border-radius: 6px;
    text-decoration: none;
    display: inline-block;
    transition: all 0.15s ease;
  }
  .hp-hero-btn:hover {
    text-decoration: none;
  }
  .hp-hero-btn.primary {
    background: #c99700;
    color: #0c2340;
  }
  .hp-hero-btn.primary:hover {
    background: #e0ac0a;
    color: #0c2340;
  }
  .hp-hero-btn.outline {
    background: transparent;
    color: var(--color-text-primary);
    border: 1px solid rgba(12, 35, 64, 0.35);
  }
  .hp-hero-btn.outline:hover {
    border-color: #c99700;
    color: var(--color-text-primary);
  }
  html[data-theme='dark'] .hp-hero-btn.outline {
    border-color: rgba(255, 255, 255, 0.35);
  }
  @media (max-width: 768px) {
    .hp-hero {
      padding: 1.25rem 1.25rem 2.5rem;
    }
    .hp-banner img {
      aspect-ratio: 3 / 2;
    }
    .hp-title {
      font-size: 36px;
    }
  }

  /* ── Hero two-column layout: text left, research diagram card right ── */
  .hp-hero-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  @media (max-width: 900px) {
    .hp-hero-grid {
      grid-template-columns: 1fr;
    }
  }
  .hp-approach-card {
    background: #fff;
    border: 1px solid rgba(12, 35, 64, 0.14);
    border-radius: 12px;
    padding: 1.25rem 1.25rem 1rem;
  }
  html[data-theme='dark'] .hp-approach-card {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.12);
  }
  .hp-approach-label {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--amp-gold);
    margin-bottom: 0.25rem;
  }

  /* Three-circle diagram: Control, Electric Machines, Power Electronics; AMPERE at the center */
  .hp-venn {
    display: block;
    width: 100%;
    max-width: 440px;
    height: auto;
    margin: 0 auto;
  }
  .hp-venn .v-c {
    stroke: #3a6ea5;
    stroke-width: 2;
  }
  .hp-venn .v-top {
    fill: rgba(58, 110, 165, 0.08);
  }
  .hp-venn .v-left {
    fill: rgba(58, 110, 165, 0.13);
  }
  .hp-venn .v-right {
    fill: rgba(58, 110, 165, 0.19);
  }
  .hp-venn .v-label {
    font-family: var(--font-heading);
    font-size: 21px;
    font-weight: 700;
    fill: #0c2340;
  }
  html[data-theme='dark'] .hp-venn .v-label {
    fill: var(--color-text-primary);
  }
  html[data-theme='dark'] .hp-venn .v-c {
    stroke: #7fa3cc;
  }
  .hp-venn .v-dot {
    fill: #c99700;
    stroke: #fff;
    stroke-width: 2.5;
  }
  .hp-venn .v-pill {
    fill: #0c2340;
    stroke: #c99700;
    stroke-width: 1.5;
  }
  .hp-venn .v-bolt {
    fill: var(--amp-gold);
  }
  .hp-venn .v-pill-text {
    font-family: var(--font-heading);
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 2px;
    fill: var(--amp-gold);
  }

  /* Typing line that cycles through the six techniques */
  .hp-approach-rotator {
    min-height: 1.6em;
    margin: 0.5rem 0 0;
    text-align: center;
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 700;
    color: #0c2340;
  }
  .hp-approach-rotator span {
    color: inherit;
  }
  html[data-theme='dark'] .hp-approach-rotator {
    color: var(--color-text-primary);
  }
  .hp-caret.is-typing {
    animation: none;
  }
  .hp-caret {
    display: inline-block;
    width: 2px;
    height: 1.05em;
    margin-left: 2px;
    vertical-align: -0.15em;
    background: currentColor;
    animation: hp-blink 1s steps(1) infinite;
  }
  @keyframes hp-blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hp-caret {
      animation: none;
    }
  }

  /* ── Mission ── */
  .hp-mission-layout {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem;
    align-items: start;
  }
  @media (max-width: 900px) {
    .hp-mission-layout {
      grid-template-columns: 1fr;
    }
  }
  .hp-mission-quote {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 600;
    font-style: normal;
    line-height: 1.4;
    color: var(--color-text-primary);
    margin: 0 0 1.5rem;
    padding-left: 1.25rem;
    border-left: 3px solid #c99700;
  }
  .hp-mission-text p {
    font-size: 18px;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin-bottom: 1.1rem;
  }
  .hp-metric-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  @media (max-width: 460px) {
    .hp-metric-grid {
      grid-template-columns: 1fr;
    }
  }
  .hp-metric-card {
    background: var(--color-background-primary);
    border: 0.5px solid var(--color-border-tertiary);
    border-left: 3px solid #c99700;
    border-radius: var(--border-radius-lg, 8px);
    padding: 1.25rem 1.35rem;
  }
  .hp-metric-card.full {
    grid-column: span 2;
  }
  @media (max-width: 460px) {
    .hp-metric-card.full {
      grid-column: span 1;
    }
  }
  .hp-metric-icon {
    font-size: 22px;
    margin-bottom: 0.6rem;
    display: inline-block;
  }
  .hp-metric-card h3 {
    font-size: 19px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-text-primary);
    margin-bottom: 0.3rem;
  }
  .hp-metric-card p {
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-text-tertiary);
    margin: 0;
  }

  /* ── Generic section ── */
  .hp-section {
    padding: 3.25rem 3rem;
    border-bottom: 1px solid var(--color-border-tertiary);
  }
  .hp-section-label {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--amp-gold);
    margin-bottom: 0.7rem;
  }
  .hp-section-title {
    font-family: var(--font-heading);
    font-size: 28px;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    margin-bottom: 1.75rem;
  }

  /* ── Research cards ── */
  .hp-research-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.1rem;
  }
  .hp-card {
    background: var(--color-background-primary);
    border: 0.5px solid var(--color-border-tertiary);
    border-radius: var(--border-radius-lg, 8px);
    overflow: hidden;
  }
  .hp-card-thumb {
    width: 100%;
    height: 160px;
    object-fit: cover;
    object-position: center;
    display: block;
    background: var(--color-background-secondary);
  }
  .hp-card-body {
    padding: 1.1rem 1.25rem 1.25rem;
  }
  .hp-card-icon {
    width: 40px;
    height: 40px;
    border-radius: var(--border-radius-md, 6px);
    background: var(--color-background-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.75rem;
  }
  .hp-card-icon i {
    font-size: 27px;
    color: #185fa5;
  }
  .hp-card h3 {
    font-size: 19px;
    font-weight: 700;
    margin-bottom: 0.4rem;
    color: var(--color-text-primary);
  }
  .hp-card p {
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  /* ── News list ── */
  .hp-news-list {
    display: flex;
    flex-direction: column;
  }
  .hp-news-item {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 0.85rem 0;
    border-bottom: 0.5px solid var(--color-border-tertiary);
  }
  .hp-news-item:last-child {
    border-bottom: none;
  }
  .hp-news-date {
    font-size: 18px;
    color: var(--color-text-tertiary);
    min-width: 82px;
    padding-top: 2px;
    flex-shrink: 0;
  }
  .hp-news-body {
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }
  .hp-news-body strong {
    color: var(--color-text-primary);
    font-weight: 500;
  }
  .hp-news-more {
    display: inline-block;
    margin-top: 1.1rem;
    font-size: 19px;
    color: #185fa5;
    text-decoration: none;
  }
  .hp-news-more:hover {
    text-decoration: underline;
  }

  /* ── Publications ── */
  .hp-pub-venue {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #185fa5;
    margin-bottom: 0.4rem;
  }
  .hp-pub-title {
    font-size: 20px;
    font-weight: 500;
    color: var(--color-text-primary);
    margin-bottom: 0.3rem;
    line-height: 1.5;
  }
  .hp-pub-authors {
    font-size: 19px;
    color: var(--color-text-secondary);
    font-style: italic;
  }
  .hp-pub-more {
    display: inline-block;
    margin-top: 1.1rem;
    font-size: 19px;
    color: #185fa5;
    text-decoration: none;
  }
  .hp-pub-more:hover {
    text-decoration: underline;
  }

  /* ── Team ── */
  .hp-team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
  }
  .hp-team-card {
    background: var(--color-background-primary);
    border: 0.5px solid var(--color-border-tertiary);
    border-radius: var(--border-radius-lg, 8px);
    overflow: hidden;
    text-align: center;
  }
  .hp-team-card.pi {
    border-color: #185fa5;
  }
  .hp-team-photo {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: top;
    display: block;
  }
  .hp-team-initials {
    width: 100%;
    aspect-ratio: 1 / 1;
    background: var(--color-background-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    font-weight: 600;
    color: #185fa5;
  }
  .hp-team-card.open .hp-team-initials {
    opacity: 0.45;
  }
  .hp-team-info {
    padding: 0.9rem 1rem 1rem;
  }
  .hp-team-card h3 {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-text-primary);
    margin-bottom: 0.2rem;
  }
  .hp-team-card p {
    font-size: 13px;
    color: var(--color-text-secondary);
  }
  .hp-team-card.open {
    border-style: dashed;
    opacity: 0.65;
  }

  /* ── Join CTA ── */
  .hp-join-box {
    background: #0c2340;
    border-radius: var(--border-radius-lg, 8px);
    padding: 2rem 2.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .hp-join-box h3 {
    font-family: var(--font-heading);
    font-size: 26px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.5rem;
  }
  .hp-join-box p {
    font-size: 15px;
    color: rgba(255, 255, 255, 0.72);
    max-width: 560px;
  }
  .hp-join-btn {
    font-size: 14px;
    font-weight: 600;
    padding: 12px 24px;
    background: #c99700;
    color: #0c2340;
    border-radius: var(--border-radius-md, 6px);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .hp-join-btn:hover {
    background: #b38600;
  }
  /* ── Recent work: match the Publications page style ── */
  .hp-wrap .publications ol.bibliography > li {
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-border-tertiary);
  }
  .hp-wrap .publications ol.bibliography > li:last-child {
    border-bottom: none;
  }
  .hp-wrap .publications abbr.badge {
    background-color: #0c2340 !important;
    border-radius: 4px !important;
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    padding: 0.3rem 0.4rem;
  }
  .hp-wrap .publications abbr.badge a {
    color: #fff !important;
  }
  .hp-wrap .publications .preview {
    border-radius: 8px !important;
    border: 1px solid var(--color-border-tertiary);
    box-shadow: none !important;
  }
  .hp-wrap .publications .title {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-text-primary);
    margin-bottom: 0.3rem;
  }
  .hp-wrap .publications .author,
  .hp-wrap .publications .periodical {
    font-size: 16px;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }
  .hp-wrap .publications .author em {
    font-style: normal;
    font-weight: 700;
    color: var(--color-text-primary);
    border-bottom: none;
    text-decoration: none;
  }
  .hp-wrap .publications .author a {
    color: var(--color-text-secondary);
    text-decoration: none;
    border-bottom: none;
  }
  .hp-wrap .publications .author a:hover {
    color: #185fa5;
  }
  .hp-wrap .publications .periodical em {
    color: inherit;
  }
  .hp-wrap .publications .links .btn {
    font-size: 13px;
    font-weight: 600;
    text-transform: none;
    padding: 0.2rem 0.6rem;
    margin: 0.4rem 0.4rem 0 0;
    border: 1px solid rgba(12, 35, 64, 0.18);
    border-radius: 4px;
    background: transparent;
    color: #185fa5 !important;
    box-shadow: none !important;
  }
  .hp-wrap .publications .links .btn:hover {
    border-color: #c99700;
  }
</style>

<div class="hp-wrap">
  <!-- ── Hero ──────────────────────────────────────────── -->
  <section class="hp-hero">
    <div class="hp-inner">
      <figure class="hp-banner">
        <img
          src="{{ '/assets/img/nd-campus-aerial-2400.jpg' | relative_url }}"
          srcset="{{ '/assets/img/nd-campus-aerial-1200.jpg' | relative_url }} 1200w, {{ '/assets/img/nd-campus-aerial-2400.jpg' | relative_url }} 2400w"
          sizes="(max-width: 1280px) 100vw, 1280px"
          alt="The Basilica of the Sacred Heart and the Golden Dome at sunset, University of Notre Dame"
          width="2400"
          height="1600"
          fetchpriority="high"
        >
        <figcaption>Photo: Michael Caterina / University of Notre Dame</figcaption>
      </figure>
      <div class="hp-hero-grid">
        <div class="hp-hero-text">
          <h1 class="hp-title">AMPERE Lab</h1>
          <p class="hp-affil">
            Department of Electrical Engineering<br>
            University of Notre Dame
          </p>
          <p class="hp-tagline">Advanced Electric Machines &amp; Power Electronics Research Laboratory</p>
          <p class="hp-hero-desc">
            AMPERE Lab studies electric machines, power electronics, and control as one connected problem to advance electro-mechanical energy
            conversion systems. Located at the University of Notre Dame, we are strategically positioned in the heart of America's industrial
            corridor.
          </p>
          <div class="hp-hero-ctas">
            <a class="hp-hero-btn primary" href="{{ '/research/' | relative_url }}">Explore Research</a>
            <a class="hp-hero-btn outline" href="{{ '/publications/' | relative_url }}">Publications</a>
            <a class="hp-hero-btn outline" href="{{ '/join/' | relative_url }}">Join the Lab</a>
          </div>
        </div>
        <div class="hp-approach-card" aria-label="Our approach">
          <div class="hp-approach-label">Our approach</div>
          <svg class="hp-venn" viewBox="0 0 600 430" role="img" aria-labelledby="hpVennTitle">
            <title id="hpVennTitle">AMPERE sits at the intersection of control, electric machines, and power electronics</title>
            <circle class="v-c v-top" cx="300" cy="145" r="128" />
            <circle class="v-c v-left" cx="210" cy="295" r="128" />
            <circle class="v-c v-right" cx="390" cy="295" r="128" />
            <text class="v-label" x="300" y="82" text-anchor="middle">Control</text>
            <text class="v-label" x="160" y="322" text-anchor="middle"><tspan x="160">Electric</tspan><tspan x="160" dy="25">Machines</tspan></text>
            <text class="v-label" x="440" y="322" text-anchor="middle"><tspan x="440">Power</tspan><tspan x="440" dy="25">Electronics</tspan></text>
            <circle class="v-dot" cx="245" cy="210" r="10" />
            <circle class="v-dot" cx="355" cy="210" r="10" />
            <circle class="v-dot" cx="300" cy="305" r="10" />
            <rect class="v-pill" x="234" y="228" width="132" height="36" rx="18" />
            <polygon class="v-bolt" points="18,8 10,36 17,36 9,62 28,30 20,30 30,8" transform="translate(247 235) scale(0.4) translate(-9 -8)" />
            <text class="v-pill-text" x="309" y="252" text-anchor="middle">AMPERE</text>
          </svg>
          <p class="hp-approach-rotator">
            <span class="sr-only">
              Multi-physics modeling, topology optimization, AI-assisted design, advanced manufacturing, advanced control, and system integration.
            </span>
            <span aria-hidden="true"><span class="hp-rot-word">Multi-physics modeling</span><span class="hp-caret"></span></span>
          </p>
          <script>
            // Type and erase each technique one letter at a time, like an editor cursor
            (function () {
              var el = document.querySelector('.hp-rot-word');
              var caret = document.querySelector('.hp-caret');
              if (!el) return;
              var words = [
                'Multi-physics modeling',
                'Topology optimization',
                'AI-assisted design',
                'Advanced manufacturing',
                'Advanced control',
                'System integration',
              ];
              var i = 0;
              var n = words[0].length;
              var erasing = true;
              function typing(on) {
                if (caret) caret.classList.toggle('is-typing', on);
              }
              function tick() {
                typing(true);
                if (erasing) {
                  n--;
                  el.textContent = words[i].slice(0, n);
                  if (n === 0) {
                    erasing = false;
                    i = (i + 1) % words.length;
                    typing(false);
                    setTimeout(tick, 500);
                  } else {
                    setTimeout(tick, 40);
                  }
                } else {
                  n++;
                  el.textContent = words[i].slice(0, n);
                  if (n === words[i].length) {
                    erasing = true;
                    typing(false);
                    setTimeout(tick, 2200);
                  } else {
                    setTimeout(tick, 85 + Math.random() * 50);
                  }
                }
              }
              setTimeout(tick, 2200);
            })();
          </script>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Mission ───────────────────────────────────────── -->
  <section class="hp-section">
    <div class="hp-inner">
      <div class="hp-section-label">Our Mission</div>
      <div class="hp-section-title">Building Better Electro-Mechanical Systems</div>
      <p style="font-size:18px; line-height:1.65; color:var(--color-text-secondary); max-width:760px; margin-bottom:2.25rem;">
        Our research is at the intersection of electric machines, power electronics, and control — with a passion for integrated, unconventional
        designs that push the performance envelope.
      </p>

      <div class="hp-mission-layout">
        <div class="hp-mission-text">
          <blockquote class="hp-mission-quote">
            "We create electro-mechanical systems that are more efficient, more affordable, more intelligent, and less dependent on critical
            materials."
          </blockquote>
          <p>
            AMPERE Lab combines rigorous analytical methods with hands-on hardware development. From winding theory and electromagnetic analysis to
            3D-printed prototypes and dynamometer testing, we pursue research that leads to real, deployable technology.
          </p>
          <p>We welcome collaboration with industry partners and are actively building a world-class team.</p>
        </div>

        <div class="hp-metric-grid">
          <div class="hp-metric-card">
            <i class="ti ti-bolt hp-metric-icon" style="color:var(--amp-gold);"></i>
            <h3>Higher Power Density</h3>
            <p>More power in compact, lighter packages</p>
          </div>
          <div class="hp-metric-card">
            <i class="ti ti-flame hp-metric-icon" style="color:var(--amp-gold);"></i>
            <h3>Lower Losses</h3>
            <p>Minimizing losses and thermal requirements</p>
          </div>
          <div class="hp-metric-card">
            <i class="ti ti-tool hp-metric-icon" style="color:var(--amp-gold);"></i>
            <h3>Greater Reliability</h3>
            <p>Minimal down-time and self-diagnosis</p>
          </div>
          <div class="hp-metric-card">
            <i class="ti ti-coin hp-metric-icon" style="color:var(--amp-gold);"></i>
            <h3>Affordability</h3>
            <p>High-performance, yet low-cost designs</p>
          </div>
          <div class="hp-metric-card full">
            <i class="ti ti-world hp-metric-icon" style="color:var(--amp-gold);"></i>
            <h3>Reduced Critical Material Dependence</h3>
            <p>Low reliance on rare-earth elements and scarce supply chains</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── News ──────────────────────────────────────────── -->
  {% if site.announcements.enabled %}
    <section class="hp-section">
      <div class="hp-inner">
        <div class="hp-section-label">Latest News</div>
        <div class="hp-section-title">Lab updates</div>
        <div class="hp-news-list">
          {% assign news_items = site.news | reverse %}
          {% for item in news_items limit: 5 %}
            <div class="hp-news-item">
              <span class="hp-news-date">{{ item.date | date: '%b %Y' }}</span>
              <div class="hp-news-body">
                {% if item.inline %}
                  {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                {% else %}
                  <a href="{{ item.url | relative_url }}" style="color:#185FA5;text-decoration:none;font-weight:500;">{{ item.title }}</a>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
        <a class="hp-news-more" href="{{ '/news/' | relative_url }}">All news →</a>
      </div>
    </section>
  {% endif %}

  <!-- ── Selected Publications ─────────────────────────── -->
  <section class="hp-section" style="border-bottom:none;">
    <div class="hp-inner">
      <div class="hp-section-label">Selected Publications</div>
      <div class="hp-section-title">Recent work</div>
      {% include selected_papers.liquid %}
      <a class="hp-pub-more" href="{{ '/publications/' | relative_url }}">All publications →</a>
    </div>
  </section>

  <!-- Sponsors (logos shared with the Research page) -->
  <section class="hp-section" style="border-top:1px solid var(--color-border-tertiary); border-bottom:none;">
    <div class="hp-inner">
      <div class="hp-section-label">Sponsors &amp; Partners</div>
      <div class="hp-section-title">Thanks to</div>
      {% include sponsors.liquid %}
    </div>
  </section>

  {% include visit_us.liquid %}
</div>
